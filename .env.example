# UniNotify Environment Configuration
PROJECT_NAME="UniNotify"
DEBUG=True
API_V1_STR="/api/v1"

# Telegram Bot
# Test bot token or your real token from @BotFather
BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567"
# Admin IDs comma separated telegram IDs
ADMIN_IDS="123456789,987654321"

# Mini App
MINI_APP_URL="https://uninotify.app"

# Database
# For SQLite local development: sqlite+aiosqlite:///./uninotify.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/uninotify
DATABASE_URL="sqlite+aiosqlite:///./uninotify.db"

# Security
SECRET_KEY="super-secret-key-change-in-production-uninotify-platform"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Timezone
TIMEZONE="Asia/Tashkent"
