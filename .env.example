# ==========================================
# UniNotify Platform Environment Configuration
# ==========================================

# Loyiha sozlamalari
PROJECT_NAME="UniNotify"
DEBUG=False
API_V1_STR="/api/v1"

# Telegram Bot
# Telegram @BotFather dan olingan bot tokeni
BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567"

# Tizim administratorlari Telegram ID lari (vergul bilan ajratilgan)
ADMIN_IDS="123456789,987654321"

# Telegram Mini App URL (Frontend domen yoki lokal manzil)
MINI_APP_URL="https://uninotify.app"

# Ma'lumotlar bazasi
# Lokal SQLite: sqlite+aiosqlite:///./uninotify.db
# PostgreSQL: postgresql+asyncpg://uninotify_user:uninotify_secret_password@localhost:5432/uninotify_db
DATABASE_URL="sqlite+aiosqlite:///./uninotify.db"

# PostgreSQL Container parametrlari (Docker ishlatganda)
POSTGRES_USER="uninotify_user"
POSTGRES_PASSWORD="uninotify_secret_password"
POSTGRES_DB="uninotify_db"

# Xavfsizlik & JWT
SECRET_KEY="production-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vaqt zonasi (Dars eslatmalari uchun)
TIMEZONE="Asia/Tashkent"

# Toq hafta boshlanadigan istalgan dushanba (YYYY-MM-DD)
WEEK_PARITY_ODD_MONDAY="2026-11-09"

# AI Provayder sozlamalari
# AI_PROVIDER: "mock" (offline/test), "gemini" (Google Gemini Multimodal Vision)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
